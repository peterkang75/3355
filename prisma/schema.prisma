generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id               String    @id @default(cuid())
  name             String
  phone            String    @unique
  nickname         String?
  gender           String?
  birthYear        String?
  region           String?
  isClubMember     String?
  club             String?
  handicap         String?
  gaHandy          String?
  houseHandy       String?
  golflinkNumber   String?
  gaRegisteredName String?
  clubMemberNumber String?
  isAdmin          Boolean   @default(false)
  isGuest          Boolean   @default(false)
  role             String    @default("회원")
  balance          Int       @default(0)
  photo            String?
  isActive         Boolean   @default(true)
  approvalStatus   String    @default("approved")
  canManageFees    Boolean   @default(false)
  isFeeExempt      Boolean   @default(false)
  lastActiveAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  posts                 Post[]
  bookings              Booking[]
  playerScores          Score[]       @relation("PlayerScores")
  markerScores          Score[]       @relation("MarkerScores")
  fees                  Fee[]         @relation("MemberFees")
  transactions          Transaction[] @relation("MemberTransactions")
  executedTransactions  Transaction[] @relation("ExecutorTransactions")
  activityLogs          ActivityLog[]
  voterPredictions      WinnerPrediction[] @relation("VoterPredictions")
  predictedWinnerOf     WinnerPrediction[] @relation("PredictedWinner")
  feedPosts             FeedPost[]         @relation("MemberFeedPosts")
  comments              Comment[]          @relation("MemberComments")
  reactions             Reaction[]         @relation("MemberReactions")
  cancellations         RoundCancellation[] @relation("MemberCancellations")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    Member   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Json     @default("[]")
  likes     Json     @default("[]")
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
}

model Booking {
  id                   String   @id @default(cuid())
  title                String?
  type                 String   @default("정기모임")
  courseName           String
  date                 String
  time                 String
  gatheringTime        String?
  organizerId          String
  organizer            Member   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  participants         String[]
  numberRentals        String[] @default([])
  status               String   @default("pending")
  notes                String?
  greenFee             Int?
  cartFee              Int?
  membershipFee        Int?
  waiveGreenFeeForClubMembers      Boolean  @default(false)
  waiveCartFeeForClubMembers       Boolean  @default(false)
  waiveMembershipFeeForClubMembers Boolean  @default(false)
  registrationDeadline String?
  restaurantName       String?
  restaurantAddress    String?
  isAnnounced          Boolean  @default(false)
  playEnabled          Boolean  @default(false)
  playManuallyDisabled Boolean  @default(false)
  isGuestAllowed       Boolean  @default(false)
  useSquadWaitlist     Boolean  @default(false)
  votingEnabled        Boolean  @default(true)
  is2BB                Boolean  @default(false)
  isRecruiting         Boolean  @default(false)
  inviteToken          String?  @unique
  isSocial             Boolean  @default(false)
  maxMembers           Int      @default(4)
  teams                Json?
  gradeSettings        Json?
  dailyHandicaps       Json?
  twoBallTeams         Json?
  photosArchivedAt     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  transactions      Transaction[]
  winnerPredictions WinnerPrediction[]
  media             RoundingMedia[]
  cancellations     RoundCancellation[]

  @@index([organizerId])
  @@index([date])
}

// 라운딩 참가 취소 이력 + 정산(환불) 처리 상태
//
// 왜 필요한가: 참가 취소는 라운딩 며칠 전에 일어나지만 실제 돈이 오가는 건 한참 뒤다.
// 예전에는 취소 시 청구를 즉시 삭제해서 이미 납부한 돈이 유령 크레딧으로 남았다.
// 이제 취소는 회계를 건드리지 않고 여기에 "정산 대기"로 쌓이고, 총무가 건별로 처리한다.
//
// status 를 별도로 저장하는 이유: '환불 없음(위약금 전액)' 처리는 거래가 아무것도
// 생기지 않으므로, 거래 유무로 파생 계산하면 영원히 대기 상태로 남는다.
model RoundCancellation {
  id           String    @id @default(cuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, name: "MemberCancellations")

  // pending          — 총무 확인 대기 (배지에 집계되는 유일한 상태)
  // charge_cancelled — 청구 취소로 종결 (미납자)
  // refunded         — 환불/크레딧전환으로 종결
  // forfeited        — 환불 없이 클럽 수입으로 확정 (위약금 등)
  status       String    @default("pending")

  chargeAmount Float?    // 취소 시점의 청구 금액 스냅샷 (참고용)
  chargeKept   Boolean   @default(true) // 취소 시 청구를 남겼는지 (false = 확실한 미납이라 자동 삭제)

  cancelledAt  DateTime  @default(now())
  cancelledBy  String?   // 취소를 실행한 사람 (본인 취소면 본인 id)
  settledAt    DateTime?
  settledBy    String?
  note         String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([bookingId, memberId])
  @@index([status])
  @@index([bookingId])
  @@index([memberId])
}

model RoundingMedia {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type          String   // "photo" | "video"
  objectKey     String   // R2 원본(압축본) 객체 key
  thumbnailKey  String?  // R2 썸네일/포스터 객체 key
  fileSize      Int      // 저장된 바이트 수 (사용량 계산용)
  durationSec   Int?     // 동영상 길이(초)
  width         Int?
  height        Int?
  uploaderPhone String   // 삭제 권한 판단 (올린 사람만)
  uploaderName  String?
  status        String   @default("ready") // "processing" | "ready" | "failed"
  createdAt     DateTime @default(now())

  @@index([bookingId])
}

model Fee {
  id          String   @id @default(cuid())
  title       String
  amount      Int
  type        String
  date        String
  dueDate     String?
  appliesTo   String
  status      String   @default("pending")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members Member[] @relation("MemberFees")

  @@index([date])
  @@index([status])
}

model Transaction {
  id            String   @id @default(cuid())
  type          String
  category      String?
  amount        Float
  memberId      String?
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade, name: "MemberTransactions")
  bookingId     String?
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  description   String?
  memo          String?
  receiptImage  String?
  receiptImages Json?
  date          String
  createdBy     String?
  executor      Member?  @relation(fields: [createdBy], references: [id], onDelete: SetNull, name: "ExecutorTransactions")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([memberId])
  @@index([bookingId])
  @@index([createdBy])
  @@index([type])
  @@index([date])
}

model MonthlySettlement {
  id          String    @id @default(cuid())
  yearMonth   String    @unique  // "2026-04"
  carryover   Int       @default(0)  // 전달 이월금
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
  closedBy    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([yearMonth])
}

model Score {
  id           String   @id @default(cuid())
  userId       String
  user         Member   @relation(fields: [userId], references: [id], onDelete: Cascade, name: "PlayerScores")
  markerId     String?
  marker       Member?  @relation(fields: [markerId], references: [id], onDelete: SetNull, name: "MarkerScores")
  roundingName String?
  date         String
  courseName   String
  totalScore   Int
  coursePar    Int      @default(72)
  holes        String?
  markerHoles  String?
  completed    Boolean  @default(false)
  verified     Boolean  @default(false)
  verifiedBy   String?
  gameMode     String?
  gameMetadata String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date, roundingName])
  @@index([userId])
  @@index([markerId])
  @@index([date])
  @@index([roundingName])
}

model Course {
  id            String  @id @default(cuid())
  name          String  @unique
  address       String
  city          String?
  state         String?
  country       String?
  latitude      Float?
  longitude     Float?
  holePars      Json?
  holeIndexes   Json?
  tees          Json?
  nearHoles     Json?   @default("[]")
  isCompetition Boolean @default(false)
  externalId    Int?
}

model AppSettings {
  id        String   @id @default(cuid())
  feature   String   @unique
  minRole   String   @default("관리자")
  enabled   Boolean  @default(false)
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncomeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NtpRecord {
  id          String   @id @default(cuid())
  bookingId   String
  memberId    String
  memberName  String
  holeNumber  Int
  distance    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bookingId, memberId, holeNumber])
  @@index([bookingId])
}

model BingoSettings {
  id              String   @id @default(cuid())
  gridSize        Int      @default(5)
  bingoTargetLines Int     @default(5)
  bingoGrid       Json     @default("[]")
  usedMembers     Json     @default("[]")
  selectedCells   Json     @default("[]")
  isEditMode      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberName String
  path       String
  action     String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([memberId])
  @@index([createdAt])
}

model WinnerPrediction {
  id                String   @id @default(cuid())
  roundingId        String
  booking           Booking  @relation(fields: [roundingId], references: [id], onDelete: Cascade)
  voterId           String
  voter             Member   @relation("VoterPredictions", fields: [voterId], references: [id], onDelete: Cascade)
  predictedWinnerId String
  predictedWinner   Member   @relation("PredictedWinner", fields: [predictedWinnerId], references: [id], onDelete: Cascade)
  grade             String
  createdAt         DateTime @default(now())

  @@unique([roundingId, voterId, grade])
  @@index([roundingId])
  @@index([voterId])
}

model FeedPost {
  id        String          @id @default(cuid())
  authorId  String
  author    Member          @relation("MemberFeedPosts", fields: [authorId], references: [id], onDelete: Cascade)
  content   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  media     FeedPostMedia[]

  @@index([authorId])
  @@index([createdAt])
}

model FeedPostMedia {
  id           String   @id @default(cuid())
  feedPostId   String
  feedPost     FeedPost @relation(fields: [feedPostId], references: [id], onDelete: Cascade)
  type         String   // "photo" | "video"
  objectKey    String
  thumbnailKey String?
  fileSize     Int      @default(0)
  durationSec  Int?
  width        Int?
  height       Int?
  status       String   @default("processing") // "processing" | "ready" | "failed"
  createdAt    DateTime @default(now())

  @@index([feedPostId])
}

model Reaction {
  id         String   @id @default(cuid())
  targetType String   // "booking" | "feedpost"
  targetId   String
  memberId   String
  member     Member   @relation("MemberReactions", fields: [memberId], references: [id], onDelete: Cascade)
  type       String   @default("like")
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, memberId, type])
  @@index([targetType, targetId])
}

model Comment {
  id         String   @id @default(cuid())
  targetType String   // "booking" | "feedpost"
  targetId   String
  authorId   String
  author     Member   @relation("MemberComments", fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([authorId])
}
